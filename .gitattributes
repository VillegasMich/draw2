# Check out every text file with LF on all platforms. Windows runners default to
# core.autocrlf=true, which would otherwise hand rustfmt CRLF files and fail
# `cargo fmt --check`.
* text=auto eol=lf

# Binary assets: never touch line endings or diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.webp binary
*.onnx binary
*.mp4 binary
